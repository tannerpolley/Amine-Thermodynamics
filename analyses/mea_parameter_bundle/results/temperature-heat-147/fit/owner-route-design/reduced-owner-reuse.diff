+def identification(record):
+    import numpy as np
+
+    name = f"{record['structure']}-start-{record['start']}"
+    summary = json.loads((HERE / f"{name}-fit.json").read_text())
+    ids = summary["coordinates"]
+    singular = summary["column_normalized_singular_values"]
+    correlation = np.array(summary["jacobian_column_correlations"], dtype=float)
+    rank_pass = singular is not None and singular[-1] / singular[0] >= 1e-8
+    correlation_pass = np.isfinite(correlation).all() and np.max(np.abs(correlation - np.eye(len(ids)))) < 0.95
+    out = {"rank_pass": bool(rank_pass), "correlation_pass": bool(correlation_pass)}
+    if fit.SLOPE in ids and singular is not None:
+        assert digest(RAW / name / "native-fit.json") == summary["native_fit_sha256"]
+        native = json.loads((RAW / name / "native-fit.json").read_text())
+        matrix = np.array(native["optimizer_jacobian"]).reshape(-1, len(ids))
+        column = ids.index(fit.SLOPE)
+        intercepts = matrix[:, [ids.index(i) for i in fit.IDS]]
+        u, values, _ = np.linalg.svd(intercepts, full_matrices=False)
+        q = u[:, values >= values[0] * 1e-8]
+        slope = matrix[:, column]
+        eta = np.linalg.norm(slope - q @ (q.T @ slope)) / np.linalg.norm(slope)
+        lo, hi = summary["bounds"][column]
+        out.update(eta=float(eta), slope_interior=lo < summary["physical"][column] < hi,
+                   intercept_rank=int(q.shape[1]))
+        out["slope_pass"] = out["slope_interior"] and eta > 0.3122499 and q.shape[1] == 4
+    out["pass"] = bool(rank_pass and correlation_pass and out.get("slope_pass", True))
+    return out
