from pathlib import Path
import subprocess

ANALYSIS = Path(workflow.basedir)
ROOT = ANALYSIS.parents[1]
UV = str(Path.home() / ".local/bin/uv")
VERIFY = ["sha256sum", "--check", "--strict", str(ANALYSIS / "retained-results.sha256")]
# Retained results were produced at 910f630, before the #152 source corrections; a source
# that changed since then must match its version at that commit.
HASH_CHECK = """import csv, hashlib, subprocess
from pathlib import Path
PRODUCED_AT = "910f6308475661e3bf014d83557c74edcc63b1c9"
for name in ("results/source_manifest.csv", "figures/output/source_manifest.csv", "figures/output/uq_source_manifest.csv"):
    path = Path("analyses/enrtl_six_species_ideal_comparison") / name
    with path.open() as stream:
        for row in csv.DictReader(stream):
            source = row["artifact"]
            if hashlib.sha256(Path(source).read_bytes()).hexdigest() == row["sha256"]:
                continue
            used = subprocess.run(["git", "show", f"{PRODUCED_AT}:{source}"], capture_output=True, check=True).stdout
            if hashlib.sha256(used).hexdigest() != row["sha256"]:
                raise SystemExit(f"source hash drift for {source}: matches neither current nor {PRODUCED_AT[:7]} version")
            print(f"historical input {source}: retained results use its {PRODUCED_AT[:7]} version")
"""


rule present:
    input: str(ANALYSIS / "retained-results.sha256")
    run:
        subprocess.run(VERIFY, cwd=ROOT, check=True)
        subprocess.run([UV, "run", "--no-sync", "python", "-c", HASH_CHECK], cwd=ROOT, check=True)
        for name in ("render_figures.py", "render_uq_figures.py"):
            subprocess.run([UV, "run", "--no-sync", "python", str(ANALYSIS / "scripts" / name)], cwd=ROOT, check=True)
        subprocess.run(VERIFY, cwd=ROOT, check=True)
        subprocess.run([UV, "run", "--no-sync", "python", "-c", HASH_CHECK], cwd=ROOT, check=True)
