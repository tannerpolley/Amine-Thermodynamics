{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mea-film-chemistry-work-package-a-v1",
  "title": "MEA film chemistry Work Package A input contract",
  "type": "object",
  "required": [
    "schema_version",
    "identity",
    "status",
    "base_commit",
    "species_order",
    "species",
    "source_reaction_order",
    "film_classification",
    "finite_reactions",
    "source_standard_conversion",
    "kinetic_correlations",
    "transport_inputs",
    "property_inputs",
    "observations",
    "source_records",
    "validation_policy",
    "exclusions"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "identity": {"const": "mea-film-chemistry-work-package-a-input-v1"},
    "status": {"const": "source_complete_nonexecutable_input_contract"},
    "base_commit": {"pattern": "^[0-9a-f]{40}$"},
    "species_order": {"type": "array", "minItems": 9, "maxItems": 9, "uniqueItems": true},
    "species": {"type": "array", "minItems": 9, "maxItems": 9},
    "source_reaction_order": {"const": ["R1", "R2", "R3", "R4", "R5"]},
    "film_classification": {"type": "array", "minItems": 5},
    "finite_reactions": {"type": "array", "minItems": 3},
    "source_standard_conversion": {"type": "object"},
    "kinetic_correlations": {"type": "array", "minItems": 4},
    "transport_inputs": {"type": "array", "minItems": 3},
    "property_inputs": {"type": "array", "minItems": 2},
    "observations": {"type": "array", "minItems": 3},
    "source_records": {"type": "array", "minItems": 4},
    "validation_policy": {"type": "object"},
    "exclusions": {"type": "object"}
  },
  "additionalProperties": false
}
