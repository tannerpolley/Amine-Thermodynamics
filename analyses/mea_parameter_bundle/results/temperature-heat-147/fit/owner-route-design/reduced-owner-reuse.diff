+def bounded_heat(mapping, row, deadline, directory):
+    directory.mkdir(parents=True, exist_ok=False)
+    save(directory / "inputs.json", {"mapping": mapping, "row": row})
+    cap = min(175.0, deadline - time.perf_counter())
+    result = {}
+    try:
+        with (directory / "worker.log").open("w") as log:
+            subprocess.run([sys.executable, __file__, "--issue147", "heat-value", str(directory)],
+                           timeout=max(0.0, cap), check=True, stdout=log, stderr=subprocess.STDOUT)
+        result = json.loads((directory / "result.json").read_text())
+        assert result["status"] == "Available", result
+        assert result["requested_tolerance_met"] is not False, result
+        assert math.isfinite(result["value"]) and math.isfinite(result["residual"])
+        return result
+    except Exception as exc:
+        result = {**result, "row": row, "status": "unavailable", "value": None, "residual": None,
+                  "message": f"{type(exc).__name__}: {exc}", "worker_log": str(directory / "worker.log"),
+                  "endpoint_checks": json.loads((directory / "endpoint-checks.json").read_text())
+                  if (directory / "endpoint-checks.json").exists() else []}
+        save(directory / "failure.json", result)
+        return result
