@article{Gross2001,
  title = {Perturbed-{{Chain SAFT}}: {{An Equation}} of {{State Based}} on a {{Perturbation Theory}} for {{Chain Molecules}}},
  author = {Gross, Joachim and Sadowski, Gabriele},
  year = 2001,
  month = feb,
  journal = {Industrial and Engineering Chemistry Research},
  volume = {40},
  number = {4},
