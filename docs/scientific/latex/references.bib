  abstract = {The enthalpies of solution ({$\Delta$}solH) of carbon dioxide (CO2) in two aqueous solutions (w = 0.1500 and w = 0.3000) of monoethanolamine (MEA) have been measured at two temperatures (322.5 K and 372.9 K) and pressures up to 5 MPa. Measurements were carried out by a flow calorimetric technique using a custom-made flow-mixing unit combined with a SETARAM C-80 isothermal differential heat-flux calorimeter. Enthalpies of solution of CO2 ({$\Delta$}solH) have been obtained as function of loading {$\alpha$} (moles CO2/mol amine). Solubility data of the gas into the different absorbent (s) were derived from the enthalpic data.},
  langid = {english},
  keywords = {/unread}
}

@article{Aronu2011,
  title = {Solubility of {{CO2}} in 15, 30, 45 and 60 Mass\% {{MEA}} from 40 to 120{$^\circ$}{{C}} and Model Representation Using the Extended {{UNIQUAC}} Framework},
  author = {Aronu, Ugochukwu E. and Gondal, Shahla and Hessen, Erik T. and {Haug-Warberg}, Tore and Hartono, Ardi and Hoff, Karl A. and Svendsen, Hallvard F.},
  year = 2011,
  journal = {Chemical Engineering Science},
  volume = {66},
  number = {24},
  pages = {6393--6406},
  publisher = {Elsevier},
  issn = {00092509},
  doi = {10.1016/j.ces.2011.08.042},
  abstract = {New experimental data for vapor-liquid equilibrium of CO2 in aqueous monoethanolamine solutions are presented for 15, 30, 45 and 60 mass\% MEA and from 40 to 120{$^\circ$}C. CO2 partial pressures over loaded MEA solutions were measured using a low temperature equilibrium apparatus while total pressures were measured with a high temperature equilibrium apparatus. Experimental data are given as CO2 partial pressure as function of loading in solution for temperatures from 40 to 80{$^\circ$}C and as total pressures for temperatures from 60 to 120{$^\circ$}C for the different MEA concentrations. The extended UNIQUAC model framework was applied and model parameters were fitted to the new experimental VLE data and physical CO2 solubility data from the literature. The model gives a good representation of the experimental VLE data for CO2 partial pressures and total pressures for all MEA concentrations with an average absolute relative deviation (AARD) of 24.3\% and 11.7\%, respectively, while the physical solubility data were represented with an AARD of 2.7\%. Further, the model predicts well literature data on freezing point depression, excess enthalpy and liquid phase speciation determined by NMR. \copyright{} 2011 Elsevier Ltd.},
  keywords = {CO2 absorption,Extended UNIQUAC,Monoethanolamine (MEA),Phase equilibria,Separations,Thermodynamic process}
}

@article{arouaEquilibriumConstantCarbamate1999,
  title = {Equilibrium {{Constant}} for {{Carbamate Formation}} from {{Monoethanolamine}} and {{Its Relationship}} with {{Temperature}}},
  author = {Aroua, Mohammed Kheireddine and Benamor, Abdelbaki and {Haji-Sulaiman}, Mohd Zaki},
  year = 1999,
  month = jul,
  journal = {Journal of Chemical \& Engineering Data},
  volume = {44},
  number = {5},
  pages = {887--891},
  issn = {0021-9568},
  doi = {10.1021/je980290n},
  urldate = {2026-08-17},
  abstract = {The equilibrium constant for the formation of carbamate from monoethanolamine was evaluated at various temperatures of 298, 308, 318, and 328 K and ionic strengths up to 1.7 M. From the plot of log10K versus I0.5, the variation of the thermodynamical constant with temperature follows the relationship log10K1 = -0.934 + (0.671 \texttimes{} 103)K/T.}
}

@article{Austgen1991,
  title = {Model of {{Vapor-Liquid Equilibria}} for {{Aqueous Acid Gas-Alkanolamine Systems}}. 2. {{Representation}} of {{H2S}} and {{CO2 Solubility}} in {{Aqueous MDEA}} and {{CO2 Solubility}} in {{Aqueous Mixtures}} of {{MDEA}} with {{MEA}} or {{DEA}}},
  author = {Austgen, David M and Rochelle, Gary T and Chen, Chau-Chyun},
  year = 1991,
  journal = {Industrial \& Engineering Chemistry Research},
  volume = {30},
  number = {3},
  pages = {543--555},
  doi = {10.1021/ie00051a016},
  abstract = {A physicochemical model developed in earlier work for representing Ha and C02 solubility in aqueous solutions of monoethanolamine (MEA) and diethanolamine (DEA) was extended to include the mixtures of methyldiethanolamine (MDEA) with MEA or DEA. The framework of the model is based upon both liquid-phase chemical equilibria and vapor-liquid (phase) equilibria. Activity coefficients are represented with the electrolyte-NRTL equation treating both long-range electrostatic interactions and short-range binary interactions. Adjustable binary interaction parameters of the model were fitted on binary and ternary system MDEA data reported in the literature. The solubility of C02 in aqueous mixtures of MDEA with MEA or DEA was measured at 40 and 80 "C over a wide range of C02 partial pressures. Representation of the data by the model is good, especially at low to moderate acid gas loadings.}
}

