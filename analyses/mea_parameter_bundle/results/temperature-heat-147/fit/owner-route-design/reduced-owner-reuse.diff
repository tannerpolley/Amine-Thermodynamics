+def heat_problem(row, template, alpha):
+    masses = {c["component_id"]: c["fixed"]["molar_mass"]["value"]["magnitude"]
+              for c in s.parameter_mapping(SOURCE)["components"]}
+    water = masses["monoethanolamine"] * 0.7 / (0.3 * masses["water"])
+    return equilibrium.Problem(
+        T=row["temperature_K"], P=row["system_pressure_Pa"],
+        feed=equilibrium.Amounts({"monoethanolamine": 1.0, "water": water, "carbon-dioxide": alpha}),
+        phases=[equilibrium.Phase("L", kind="liquid", support=s.COMPONENT_IDS)],
+        reactions=template.reactions, neutral_reference=template.neutral_reference,
+    )
+
+
+def heat_observation(params, row, template):
+    initial = heat_problem(row, template, 0.0)
+    final = heat_problem(row, template, row["alpha_final"])
+    return regression.addition_enthalpy(
+        params, initial, final, {"carbon-dioxide": 1.0}, row["alpha_final"],
+        row["temperature_K"], row["system_pressure_Pa"], phase="vapor",
+        observed=row["observed_addition_enthalpy_J_per_mol_CO2"],
+        form="difference", scale=row["uH_J_per_mol_CO2"],
+    )
+
+
+def heat_value(mapping, row, directory):
+    params = probe.epcsaft.Parameters.from_mapping(mapping)
+    model = probe.epcsaft.Mixture(params, thermochemistry=THERMOCHEMISTRY)
+    request = s.corrected_request(verify_inputs()[0]["request"], s.reaction_values(mapping))
+    template = s._problem_from_request(request)
+    diagnostics = []
+    for alpha in (0.0, row["alpha_final"]):
+        problem = heat_problem(row, template, alpha)
+        system = copy.deepcopy(request["reaction_system"])
+        feed = [problem.feed.values.get(i, 0.0) for i in s.COMPONENT_IDS]
+        system["feed_amounts_mol"] = feed
+        system["conserved_totals"] = [math.fsum(c * n for c, n in zip(a, feed, strict=True))
+                                      for a in system["balance_matrix"]]
+        endpoint = {"reaction_system": system}
+        boundary = equilibrium.Problem(
+            T=row["temperature_K"], P=equilibrium.Free(), feed=problem.feed,
+            phases=[problem.phases[0], equilibrium.Phase("V", kind="vapor",
+                    support=s.COMPONENT_IDS[:3], amount=equilibrium.Pinned(0))],
+            reactions=problem.reactions, neutral_reference=problem.neutral_reference,
+        )
+        for kind, declaration in (("fixed-pressure", problem), ("bubble", boundary)):
+            solved = equilibrium.solve_equilibrium(model, declaration)
+            state = s._snapshot_from_result(model, declaration, endpoint, solved)
+            check = check_state(state, {"request": endpoint})
+            diagnostics.append({"alpha": alpha, "kind": kind, "state": state, "check": check})
+            save(directory / "endpoint-checks.json", diagnostics)
+            assert check["complete"], diagnostics[-1]
+            if kind == "bubble":
+                assert row["system_pressure_Pa"] > state["phases"][0]["pressure_pa"] * (1 + 1e-7)
+    feed_params = probe.epcsaft.Parameters.from_mapping(mapping, components=["carbon-dioxide"])
+    feed_calorics = probe.epcsaft.ThermochemistryRecord(
+        THERMOCHEMISTRY.standard_pressure,
+        [THERMOCHEMISTRY.component_intervals[s.COMPONENT_IDS.index("carbon-dioxide")]],
+    )
+    feed = probe.epcsaft.Pure(feed_params, thermochemistry=feed_calorics).state(
+        row["temperature_K"], P=row["system_pressure_Pa"], phase="vapor",
+    )
+    feed_values = {k: s._jsonable(getattr(feed, k)) for k in
+                   ("stable_root_count", "molar_density", "pressure_density_derivative", "total_enthalpy")}
+    save(directory / "feed.json", feed_values)
+    assert feed.stable_root_count == 1 and feed.molar_density > 0
+    assert feed.pressure_density_derivative > 0 and math.isfinite(feed.total_enthalpy)
+    prediction = regression.predict(model, heat_observation(params, row, template))
+    return {
